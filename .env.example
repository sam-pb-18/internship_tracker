# Prefer the Transaction pooler value from Supabase → Connect, unchanged.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# A long, unique secret used by the website and iPhone Shortcuts.
TRACKER_API_TOKEN=replace-with-a-long-random-secret

# Ignore location-triggered check-outs shortly after a check-in. Adjust if needed.
AUTO_CHECKOUT_MINUTES=30
